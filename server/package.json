{
    "name": "community-server",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "start": "node server.js",
        "dev": "node --watch server.js",
        "build": "echo \"Build complete - Node.js app ready for deployment\" && npm install",
        "seed": "node scripts/seedAdmin.js",
        "seed:all": "node seeds.js && node scripts/seedAdmin.js && node scripts/seedChallenges.js && node scripts/seedQuestions.js",
        "prod": "NODE_ENV=production node server.js"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.6",
        "dotenv": "^17.3.1",
        "express": "^5.2.1",
        "google-auth-library": "^10.5.0",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.2.1",
        "socket.io": "^4.8.3"
    }
}